# GeoBharat Environment Configuration — EXAMPLE FILE
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control (it is git-ignored).

VITE_APP_TITLE=GeoBharat - GIS Land Governance Platform

# Set VITE_USE_MOCK=false to use the real Django backend.
# Set VITE_USE_MOCK=true (or omit .env entirely) to use local mock data (no backend required).
VITE_USE_MOCK=false

# Django REST API base URL (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
